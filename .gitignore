# Python bytecode & test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Office / Excel temporary lock files & local inspector delta cache
~$*
.nea_inspect_cache.json
.sandbox_scratch/

# Syncthing local state & conflict/temp artifacts (Part 2 offline sync hygiene)
.stfolder/
.stversions/
.syncthing.*
*~syncthing~*

# Standalone Clean-Room Homunculus repository & local workstation .agents symlinks (regenerated by bootstrap_workstation.sh)
/Homunculus/
/.agents/

# Disposable local study briefs (non-consumed /teach-me artifacts; keep README & .gitkeep only)
study_briefs/*
!study_briefs/README.md
!study_briefs/.gitkeep

# Obsidian volatile UI state, derived scoring/AST caches & local trash in Dual-Mode memory root
memory/.obsidian/workspace.json
memory/.obsidian/workspace-mobile.json
memory/.trash/
memory/.cache/*_scoring_vectors.json
**/.cache/ast_map_cache.json
**/.cache/homunculus_tree_stamp.json
