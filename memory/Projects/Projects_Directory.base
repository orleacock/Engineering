# Auto-generated by Homunculus sync_memory.py (Dual-Mode Obsidian Visual-Brain)
filters:
  and:
    - file.inFolder("Projects")
    - file.ext == "md"
    - "project != null"

properties:
  file.name:
    displayName: "Project Dossier"
  note.entity:
    displayName: "Entity"
  note.compartment:
    displayName: "Compartment"
  note.project_type:
    displayName: "Archetype"
  note.status:
    displayName: "Status"
  note.repo_head_sha:
    displayName: "HEAD SHA"
  note.checkpoint_worktree:
    displayName: "Worktree State"
  note.last_synced:
    displayName: "Last Synced"
  note.local_path:
    displayName: "Repository Path"

views:
  - type: table
    name: "All Indexed Projects"
    order:
      - file.name
      - note.entity
      - note.compartment
      - note.project_type
      - note.status
      - note.repo_head_sha
      - note.checkpoint_worktree
      - note.last_synced
      - note.local_path
  - type: table
    name: "Entity: Alchemical-3D"
    filters:
      and:
        - 'entity == "Alchemical-3D"'
    order:
      - file.name
      - note.compartment
      - note.project_type
      - note.status
      - note.repo_head_sha
      - note.checkpoint_worktree
      - note.local_path
  - type: table
    name: "Entity: NetCom"
    filters:
      and:
        - 'entity == "NetCom"'
    order:
      - file.name
      - note.compartment
      - note.project_type
      - note.status
      - note.repo_head_sha
      - note.checkpoint_worktree
      - note.local_path
  - type: table
    name: "Entity: Orin_Workstation"
    filters:
      and:
        - 'entity == "Orin_Workstation"'
    order:
      - file.name
      - note.compartment
      - note.project_type
      - note.status
      - note.repo_head_sha
      - note.checkpoint_worktree
      - note.local_path
  - type: cards
    name: "Session Handoff & Checkpoint Cards"
    order:
      - file.name
      - note.entity
      - note.compartment
      - note.repo_head_sha
      - note.checkpoint_worktree
